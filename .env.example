# Copy to .env and edit. Every line is optional.
MODEL_PATH=./fine_tuned_intent_model
SLM_COST=0.001
LLM_COST=0.020
PROFIT_THRESHOLD=5.0
HIGH_RISK_THRESHOLD=0.7
QUICK_MODE=true
QUICK_SAMPLE_SIZE=1500
QUICK_EPOCHS=1
TRAINING_EPOCHS=3
BATCH_SIZE=8
MAX_LENGTH=128
LEARNING_RATE=2e-5
PREFERRED_PRODUCTION_MODEL=DistilBERT
# LLM_PROVIDER: mock (default, offline) | ollama | openai | groq
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=llama3.2
API_URL=http://127.0.0.1:8000
